{
  "name": "pos-payments-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Estratégia de QA para pagamentos POS: API, mock de autorizador, testes de API, UI mobile, contrato, Robot, Locust e SQL Server.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n mock,api -c magenta,green \"npm:start:mock\" \"tsx watch api/src/server.ts\"",
    "start": "tsx api/src/server.ts",
    "start:mock": "tsx mocks/authorizer/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --project=api --grep @smoke",
    "test:ui": "playwright test --project=mobile",
    "test:bug": "cross-env BUG_MODE=1 playwright test --project=api --project=mobile --grep @idempotencia",
    "test:contract:consumer": "vitest run tests/contract/consumer",
    "test:contract:provider": "vitest run tests/contract/provider",
    "test:contract": "npm run test:contract:consumer && npm run test:contract:provider",
    "pact:publish": "tsx scripts/pact-publish.ts",
    "test:robot": "python -m robot --outputdir reports/robot robot/tests",
    "test:perf": "python -m locust -f performance/locustfile.py --headless -u 20 -r 5 -t 30s --host http://localhost:3000 --html reports/locust.html --only-summary",
    "db:init": "tsx scripts/db-init.ts",
    "db:up": "docker compose up -d sqlserver",
    "test:db": "cross-env DB_MODE=sqlserver playwright test --project=db"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mssql": "^12.7.14"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}

{
  "name": "pos-payments-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Projeto de demonstração de QA para pagamentos POS: API, mock de autorizador, testes de API, UI mobile, contrato, Robot, Locust e SQL Server.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n mock,api -c magenta,green \"npm:start:mock\" \"tsx watch api/src/server.ts\"",
    "start": "tsx api/src/server.ts",
    "start:mock": "tsx mocks/authorizer/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --project=api --grep @smoke",
    "test:ui": "playwright test --project=mobile",
    "test:bug": "cross-env BUG_MODE=1 playwright test --project=api --project=mobile --grep @idempotencia"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
